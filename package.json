{
  "name": "cronometer-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace cronometer-mcp-worker",
    "inspector": "npx @modelcontextprotocol/inspector@latest",
    "deploy": "npm run deploy --workspace cronometer-mcp-worker",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "codegen": "npm run codegen --workspace @cronometer-mcp/cronometer-client",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^6.0.0",
    "globals": "^16.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
