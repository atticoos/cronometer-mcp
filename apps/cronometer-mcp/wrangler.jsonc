{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "cronometer-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-20",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "ad1fbfd376d24ff3863853d60f9531f5"
		}
	],
	"triggers": {
		"crons": ["17 3 * * *"]
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}