{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "cronometer-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-20",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"preview_urls": true,
	// Plain-text (non-secret) vars. CI preview deploys override OTEL_SERVICE_NAME
	// with --var so preview traces are separable from production.
	"vars": {
		"OTEL_SERVICE_NAME": "cronometer-mcp"
	},
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "ad1fbfd376d24ff3863853d60f9531f5"
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}
