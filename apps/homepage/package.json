{
  "name": "homepage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "npm run typecheck && vinext build",
    "preview": "vite preview",
    "deploy": "npm run typecheck && vinext-cloudflare deploy",
    "deploy:dry-run": "npm run typecheck && vinext-cloudflare deploy --dry-run",
    "cf-typegen": "wrangler types",
    "lint": "eslint app worker vite.config.ts --max-warnings 0",
    "test": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.0.0-beta.6",
    "next": "^16.3.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-server-dom-webpack": "^19.2.6",
    "vinext": "^1.0.0-beta.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitejs/plugin-rsc": "^0.5.34",
    "tailwindcss": "^4.1.0",
    "typescript": "6.0.3",
    "vite": "^8.0.0",
    "wrangler": "^4.126.0"
  }
}
